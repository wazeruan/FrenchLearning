<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Coco" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/navy</item>
        <!-- The page has its own dark theme: stop One UI's "dark mode for apps" from inverting it. -->
        <item name="android:forceDarkAllowed">false</item>
        <!-- Draw behind the punch-hole camera; MainActivity pads the page clear of it. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
